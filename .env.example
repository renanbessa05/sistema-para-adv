# Copie para .env.local e preencha. Nunca commite .env.local.
# Detalhes de cada conta em docs/deploy.md.

# --- Supabase (Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Chave publishable (sb_publishable_...). O nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY tambem funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secret (sb_secret_...), so no servidor. O nome antigo SUPABASE_SERVICE_ROLE_KEY tambem funciona.
SUPABASE_SECRET_KEY=

# --- App ---
APP_URL=http://localhost:3000
APP_TIMEZONE_PADRAO=America/Cuiaba
# String aleatoria longa; a Vercel envia "Authorization: Bearer $CRON_SECRET" nas rotinas de /api/jobs/*
CRON_SECRET=

# --- Claude API (https://platform.claude.com) ---
ANTHROPIC_API_KEY=
IA_MODELO_TRIAGEM=claude-haiku-5-5
IA_MODELO_RESUMO=claude-haiku-5-5
IA_MODELO_PECAS=claude-sonnet-5-5
IA_MODELO_PECAS_FORTE=claude-opus-5-5
# Teto mensal em USD; o job de classificacao pausa ao atingir
IA_TETO_MENSAL_USD=50
# Modelo do chat da assistente e limites de PDF enviado à API (acima disso vai como texto extraído)
IA_MODELO_CHAT=claude-sonnet-5-5
IA_TIMEOUT_MS=280000
IA_PDF_MAX_MB=20
IA_PDF_MAX_PAGINAS=300
# 1 roda a regressão do classificador e as avaliações dos agentes contra a API real
IA_TESTE_REAL=

# --- DJEN e DataJud (CNJ) ---
DJEN_BASE_URL=https://comunicaapi.pje.jus.br
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# Chave publica do DataJud (wiki do CNJ). Opcional aqui: o socio pode gravar em Configuracoes -> Integracoes (Vault).
DATAJUD_API_KEY=

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_REMETENTE="Assistente Juridica <assistente@seudominio.adv.br>"

# --- WhatsApp Cloud API (Meta) ---
# Do app (ficam na Vercel):
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Do escritorio (preferir Configuracoes -> Integracoes, que guarda no Vault; aqui so como fallback):
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Testes de banco (Postgres 16 local) ---
# DATABASE_URL_TESTE=postgres://adv_teste:adv_teste@127.0.0.1:5432/postgres

# --- Build sem variaveis (CI) ---
# SKIP_ENV_VALIDATION=1

# --- Sentry (opcional; sem DSN fica desligado) ---
# SENTRY_DSN=
